# ============================================================
#  COPY CREW — configuración
#  Copia este archivo como .env y rellena las 4 primeras claves.
# ============================================================

# --- Obligatorio -------------------------------------------------
# API key de https://dashboard.helius.dev (plan gratuito)
HELIUS_API_KEY=

# Clave privada de la wallet del bot. Si la dejas vacía en el formulario de configuración,
# se genera una wallet nueva automáticamente. NUNCA uses tu wallet principal.
PRIVATE_KEY=

# Dirección pública de tu servidor, ej: http://203.0.113.10:3000
PUBLIC_URL=

# Contraseña para entrar al panel desde el móvil
DASHBOARD_PASSWORD=

# Tu wallet personal (Phantom). El botón "Retirar" del panel solo puede enviar aquí.
WITHDRAW_ADDRESS=

# --- Modo ---------------------------------------------------------
# watch = mira y simula (sin gastar)   live = dinero real
# Se puede cambiar desde el panel.
MODE=watch
PORT=3000

# --- Dinero (en dólares) -----------------------------------------
SPEND_CAP_USD=100        # máximo invertido a la vez en posiciones abiertas
MAX_TRADE_USD=15         # máximo por operación
MIN_TRADE_USD=4          # mínimo por operación (menos no compensa las comisiones)
COPY_PCT=10              # % del tamaño de compra de la smart wallet que copiamos
MAX_OPEN_POSITIONS=3
LOSS_LIMIT_PCT=50        # si el capital cae este % desde el inicio, el bot deja de comprar
SOL_RESERVE=0.03         # SOL que nunca se toca (para comisiones)

# --- Scout ----------------------------------------------------------
CONFIRM_WALLETS=2        # nº de smart wallets que deben comprar el mismo token
CONFIRM_WINDOW_MIN=15    # ...dentro de esta ventana de minutos
MIN_WALLET_BUY_SOL=0.3   # ignorar compras más pequeñas que esto

# --- Filter (reglas duras) -----------------------------------------
MAX_TOP10_PCT=35
MAX_DEV_PCT=5
MIN_LIQUIDITY_USD=25000
MIN_LP_BURNED_PCT=90

# --- Analyst --------------------------------------------------------
MAX_ENTRY_PREMIUM_PCT=30 # si el precio ya subió más que esto desde la compra de la wallet, no entra

# --- Guard ----------------------------------------------------------
STOP_LOSS_PCT=20
TAKE_PROFIT_PCT=100
TRAIL_ACTIVATE_PCT=30    # a partir de +30% activa el stop dinámico
TRAIL_PCT=20             # vende si cae 20 puntos desde el máximo
MAX_HOLD_MIN=120         # vende pase lo que pase tras 2 horas
FOLLOW_WALLET_SELLS=true # si la smart wallet vende, nosotros también
FOLLOW_SELL_MIN_PCT=50   # ...pero solo si vendió al menos este % de lo que compró
PARTIAL_TP_PCT=25        # al llegar a +25% vende una parte y sube el stop del resto a 0%
PARTIAL_TP_FRACTION=0.5  # parte que se vende (0.5 = la mitad)
MOMENTUM_FILTER=true     # solo tokens que suben en la última hora y con más compras que ventas (5 min)
WALLET_VETO=true         # deja de copiar wallets con 3+ copias en pérdidas

# --- Estrategias (también se activan desde el panel) ------------------
TOP10_SAFETY=true        # Top 10 con Filter + prueba anti-trampa + Analyst (false = sin protección, más riesgo)
STRAT_TOP10=true         # copiar al instante a las 10 mejores wallets del momento (sin Filter/Analyst)
STRAT_PATTERNS=true      # operar patrones de gráfico que el bot ha aprendido
TOP_N=10
PATTERN_TP_PCT=15        # salidas de la estrategia de patrones
PATTERN_SL_PCT=8
PATTERN_HOLD_CANDLES=12  # velas de 5 min (12 = 1 hora)
PATTERN_REQUIRE_PROOF=false # false = opera todos los patrones clásicos; true = solo los que lo demuestran con datos
PATTERN_MIN_SAMPLES=30   # (con REQUIRE_PROOF) casos vistos antes de confiar en un patrón
PATTERN_MIN_WINRATE=60   # (con REQUIRE_PROOF) % de acierto mínimo para operar un patrón
PATTERN_INTERVAL_MIN=3   # cada cuántos minutos se analizan los gráficos

# --- Binance (monedas grandes, patrones comprobados; de momento simulado) ---
STRAT_BINANCE=true
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT
BINANCE_INTERVAL=15m
BINANCE_TP_PCT=2         # objetivo
BINANCE_SL_PCT=1         # stop
BINANCE_HOLD_CANDLES=16  # 16 velas de 15 min = 4 h como máximo
BINANCE_TRADE_USD=20     # tamaño por operación (simulado)
BINANCE_START_USD=100    # saldo simulado inicial
BINANCE_MAX_POSITIONS=3

# --- Hunter (busca smart wallets nuevas automáticamente) -----------
HUNTER=true
HUNTER_MAX_WALLETS=500   # tope de wallets vigiladas en total
HUNTER_MIN_PNL_USD=300   # ganancia mínima observada
HUNTER_MIN_TOKENS=3      # nº mínimo de tokens comprados y vendidos
HUNTER_MIN_WINRATE=50    # % mínimo de tokens con ganancia
HUNTER_INTERVAL_MIN=15

# --- Ejecución ------------------------------------------------------
SLIPPAGE_BPS=1500        # 15% (las memecoins se mueven rápido)
PRIORITY_MAX_LAMPORTS=1000000  # máx 0.001 SOL de prioridad por transacción
JUPITER_URL=https://lite-api.jup.ag
